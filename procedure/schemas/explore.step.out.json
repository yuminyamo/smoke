{
  "$comment": "カード explore.step の出力(stages.md §10 パートC)。tools/pms/lib/schema.mjs が検査する。x-vocab は vocab.yaml のキーを指す(値を書き写さない)。記録(exploration-log)は pms がこの出力と pms act の記録から書く",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "verdict", "seqs", "fragile", "verification", "observed", "assertion_hint", "carried_data", "nondeterministic", "wait", "health_signal", "blocked_by", "discrepancies", "handoffs", "procedure_signals", "ops_registered", "evidence", "notes"],
  "properties": {
    "result": { "enum": ["explored", "cannot_proceed"], "description": "explored = ステップを探索して判定した(blocked を含む)/ cannot_proceed = カードの範囲で判断できない(人間へ回る。理由を notes に書く)" },
    "verdict": { "type": ["string", "null"], "x-vocab": "verdict", "description": "このステップの判定。cannot_proceed のときは null" },
    "seqs": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true, "description": "このステップの操作の連番(pms act の seq。成功した最短の列を順に。snapshot・assert・screenshot は入れない)。操作がなければ []" },
    "fragile": {
      "type": "array", "description": "CSS の暫定ロケータを使った連番と理由(00 ■ロケータ規約の6。なければ [])",
      "items": { "type": "object", "additionalProperties": false, "required": ["seq", "reason"], "properties": {
        "seq": { "type": "integer", "minimum": 1, "description": "seqs のうち CSS の暫定ロケータの連番" },
        "reason": { "type": "string", "minLength": 10, "maxLength": 200, "description": "安定ロケータを取れない理由と壊れやすさ(1文)" } } }
    },
    "verification": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["method", "screen_seqs", "db", "reason"],
      "description": "期待結果の確かめ方(blocked・cannot_proceed のときは null)",
      "properties": {
        "method": { "type": "string", "x-vocab": "verification", "description": "使った検証手段(変えてよいのは検証手段だけ。R-EXP-9)" },
        "screen_seqs": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "画面で確かめた pms act assert の連番(画面・両方のとき1つ以上)" },
        "db": { "type": ["object", "null"], "additionalProperties": false, "required": ["query", "result"], "description": "DB で確かめたとき(DB・両方)。SELECT のみ",
          "properties": {
            "query": { "type": "string", "minLength": 10, "maxLength": 600, "description": "実行した SELECT(自シナリオのデータに限る)" },
            "result": { "type": "string", "minLength": 1, "maxLength": 200, "description": "結果の要点(件数・値)" } } },
        "reason": { "type": ["string", "null"], "maxLength": 200, "description": "DB 単独の理由、またはシナリオの検証手段から変えた理由(1文。なければ null)" }
      }
    },
    "observed": { "type": ["string", "null"], "minLength": 10, "maxLength": 300, "description": "観測した事実(画面の表示・DB の値。判断ではなく事実)" },
    "assertion_hint": { "type": ["string", "null"], "minLength": 10, "maxLength": 400, "description": "作業20への機械的な検証方法の提案(blocked 以外は必須。自データにスコープ。なければ「決定的な検証手段が見つからない」)" },
    "carried_data": { "type": "object", "description": "持ち回るデータの更新(名前 → 実値。なければ {})" },
    "nondeterministic": {
      "type": "array", "description": "扱った非決定値(なければ [])",
      "items": { "type": "object", "additionalProperties": false, "required": ["value", "catalog_id", "strength"], "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 60, "description": "値の名前(例 ジョブID)" },
        "catalog_id": { "type": "string", "pattern": "^(ND-(UI|DB|Q)-\\d{3}|未登録)$", "description": "非決定値カタログのID。未登録なら 未登録(推測で強度を決めない)" },
        "strength": { "type": ["string", "null"], "maxLength": 20, "description": "カタログの強度(登録済みのとき写す。未登録なら null)" } } }
    },
    "wait": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["condition", "measured_seconds", "timeout_used"],
      "description": "非同期待機をしたとき(なければ null)",
      "properties": {
        "condition": { "type": "string", "minLength": 6, "maxLength": 200, "description": "待機条件(目的の状態が成立した、の形で)" },
        "measured_seconds": { "type": "number", "minimum": 0, "description": "実測の秒数" },
        "timeout_used": { "type": "integer", "minimum": 1, "description": "使ったタイムアウト(秒)" } }
    },
    "health_signal": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["kind", "detail", "observed_at"],
      "description": "健全性シグナル(なければ null。あれば判定は passed にしない)",
      "properties": {
        "kind": { "type": "string", "x-vocab": "health_signal_kind", "description": "種類" },
        "detail": { "type": "string", "minLength": 10, "maxLength": 200, "description": "要点" },
        "observed_at": { "type": "string", "description": "観測した時刻(vocab.timestamp_format。観測した pms act の操作の時刻の範囲内)" } }
    },
    "blocked_by": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["reason", "detail", "ref", "handoff", "ext_demand", "resume_from"],
      "description": "判定が blocked のとき(それ以外は null)。申し送り・外部操作需要の行は pms が書く",
      "properties": {
        "reason": { "type": "string", "description": "理由コード(vocab.reason_code)" },
        "detail": { "type": "string", "minLength": 10, "maxLength": 200, "description": "実行できない内容(何が足りないか・何に当たるか)" },
        "ref": { "type": ["string", "null"], "maxLength": 40, "description": "禁止操作 なら禁止ID(PROH-<3桁>)か包括原則の番号(包括原則1〜4)。それ以外は null でよい" },
        "handoff": { "type": ["string", "null"], "pattern": "^HO-[A-Za-z0-9]+-\\d{3}$", "description": "パートBで記録済みの申し送りID(あれば。なければ null で、pms が足す)" },
        "ext_demand": {
          "type": ["string", "object", "null"], "pattern": "^EXT-\\d{3}$",
          "description": "操作手段なし のとき必須。既存の需要ID か、外部操作需要リストに書く項目",
          "additionalProperties": false, "required": ["operation", "target", "gap", "alternative", "prohibition"],
          "properties": {
            "operation": { "type": "string", "minLength": 4, "maxLength": 60, "description": "外部操作を業務語で" },
            "target": { "type": "string", "pattern": "^(実機|シミュレータ|CLIENT|AD|SMTP|PMS-OS|VM)(:.+)?$", "description": "操作対象" },
            "gap": { "type": "string", "x-vocab": "ext_gap", "description": "不足の区分" },
            "alternative": { "type": "string", "x-vocab": "ext_alternative", "description": "代替手段の見込み" },
            "prohibition": { "type": "string", "minLength": 4, "maxLength": 60, "description": "禁止操作リストの該当行ID または 該当なし" } } },
        "resume_from": { "type": "string", "pattern": "^SC-[A-Za-z0-9]+-\\d+-S\\d+$", "description": "blocked が解けたら探索を再開するステップ(このステップか後のステップ)" }
      }
    },
    "discrepancies": {
      "type": "array", "description": "文書と実画面の食い違い(DISC の案。ID は pms が採番する。なければ [])",
      "items": { "type": "object", "additionalProperties": false, "required": ["kind", "spec", "manual", "existing_test", "actual", "evidence_seq", "assessment", "notes"], "properties": {
        "kind": { "type": "string", "x-vocab": "discrepancy_kind", "description": "種別" },
        "spec": { "type": "string", "minLength": 4, "maxLength": 200, "description": "仕様書の記載(文書名+章番号+要旨。なければ 記載なし(該当章))" },
        "manual": { "type": "string", "minLength": 4, "maxLength": 200, "description": "マニュアルの記載(同上)" },
        "existing_test": { "type": ["string", "null"], "maxLength": 200, "description": "既存テストの記載(参照したときだけ)" },
        "actual": { "type": "string", "minLength": 10, "maxLength": 300, "description": "実画面の挙動" },
        "evidence_seq": { "type": ["integer", "null"], "minimum": 1, "description": "証跡の pms act screenshot の連番" },
        "assessment": { "type": "string", "x-vocab": "discrepancy_assessment", "description": "AIの見立て" },
        "notes": { "type": ["string", "null"], "maxLength": 200, "description": "再現手順の要点・発生条件" } } }
    },
    "handoffs": {
      "type": "array", "description": "扱わないと判断した対象・気づき(申し送り。行は pms が書く。なければ [])",
      "items": { "type": "object", "additionalProperties": false, "required": ["target", "reason", "means"], "properties": {
        "target": { "type": "string", "minLength": 10, "maxLength": 200, "description": "対象(1文で具体的に)" },
        "reason": { "type": "string", "x-vocab": "reason_code", "description": "理由コード" },
        "means": { "type": ["string", "null"], "maxLength": 60, "description": "想定手段(なければ null。埋めるために推測しない)" } } }
    },
    "procedure_signals": {
      "type": "array", "description": "手順改善シグナル(手順について迷った・矛盾を見つけた・実行できなかった・違う方法で実施した。行は pms が書く。なければ [])",
      "items": { "type": "object", "additionalProperties": false, "required": ["type", "location", "event", "impact", "response", "proposal"], "properties": {
        "type": { "type": "string", "x-vocab": "signal_type", "description": "種別" },
        "location": { "type": "string", "pattern": "^(ST|CM|VO|PD|TP|MT)/.+", "description": "手順箇所(vocab.procedure_location の書式)" },
        "event": { "type": "string", "minLength": 10, "maxLength": 200, "description": "事象(事実)" },
        "impact": { "type": "string", "minLength": 2, "maxLength": 100, "description": "影響(やり直し・調査の回数など。なければ なし)" },
        "response": { "type": "string", "minLength": 4, "maxLength": 200, "description": "採った対応・解釈" },
        "proposal": { "type": ["string", "null"], "maxLength": 200, "description": "改善案(任意)" } } }
    },
    "ops_registered": { "type": "array", "items": { "type": "string", "pattern": "^OP-[A-Z0-9]+-\\d{3}$" }, "uniqueItems": true, "description": "このステップで KB T05 に新しく登録した操作ID(なければ [])" },
    "evidence": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true, "description": "証跡の pms act screenshot の連番(failed・human-check は1つ以上)" },
    "notes": { "type": ["string", "null"], "maxLength": 300, "description": "失敗した試行の要点・マニュアルに手順がなかったこと(なければ null)。cannot_proceed のときは理由(必須)" }
  },
  "allOf": [
    { "if": { "properties": { "result": { "const": "cannot_proceed" } } },
      "then": { "properties": { "notes": { "type": "string", "minLength": 10 } } } },
    { "if": { "properties": { "result": { "const": "explored" } } },
      "then": { "properties": { "verdict": { "type": "string" } } } },
    { "if": { "properties": { "verdict": { "const": "blocked" } } },
      "then": { "properties": { "blocked_by": { "type": "object" }, "verification": { "type": "null" } } } },
    { "if": { "properties": { "verdict": { "enum": ["passed", "failed", "human-check"] } } },
      "then": { "properties": { "blocked_by": { "type": "null" }, "verification": { "type": "object" }, "observed": { "type": "string" }, "assertion_hint": { "type": "string" } } } }
  ]
}
